    Follow us on social media to <span class="callActionPhrase" id="callAction-rotating-phrase"> to keep up to date</span>
</div> -->

<div class="callActionSubLine">
  Follow us on social media to&nbsp;
  <span class="callActionPhrase" id="callAction-rotating-phrase">keep up to date</span>
  <span class="callActionPhrase callActionPlaceholder">this is a long phrase, if you see this you should enable JavaScript</span>
</div>

<script>
    const phrases = [
      " find your next favorite band",
      " find your next favorite songs",
      " keep up to date",
      " find your next obession"
    ];
  
    let index = 0;
    const phraseEl = document.getElementById("callAction-rotating-phrase");
  
    function rotatePhrase() {
      index = (index + 1) % phrases.length;
      if (phraseEl) {
        phraseEl.classList.remove("fade-in");
        void phraseEl.offsetWidth; // Trigger reflow to restart animation
        phraseEl.textContent = phrases[index];
        phraseEl.classList.add("fade-in");
      }
    }
  
    setInterval(rotatePhrase, 4500);
</script>
  

<style>
.callActionSubLine {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 600;
  color: white;
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
  line-height: 1.4;
  letter-spacing: -0.01em;
  padding: 0.5rem 1rem;

  /* 💡 Layout stability: reserve space for up to 2 lines */
  min-height: calc(2.5rem * 1.4 * 2.2);

  /* Optional: keep text centered vertically if it doesn't wrap */
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.25rem;
}
  
.callActionPhrase {
  position: relative;
  display: inline-block;
  white-space: nowrap;

  transition: all 0.4s ease;
}

/* Replace border with this */
.callActionPhrase::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0.05em; /* tighter to the text */
  height: 2px;
  width: 100%;
  background-color: rgba(255, 255, 255, 0.6); /* white-ish, tweak as needed */
}

.callActionPlaceholder {
  visibility: hidden;
  position: absolute;
  pointer-events: none;
  height: 0;
  overflow: hidden;
}

/* Keep your existing animation class */
.fade-in {
  animation: fadeSlideUp 0.4s ease forwards;
}

@keyframes fadeSlideUp {
  0% {
    opacity: 0;
    transform: translateY(0.4em);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>