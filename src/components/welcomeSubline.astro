---

<div class="welcomeSubLine">
  The world's foremost source of&nbsp;
  <span class="welcomePhrase" id="welcome-rotating-phrase">indie hits</span>
  <span class="welcomePhrase welcomePlaceholder">this is a long phrase, if you see this you should enable JavaScript</span>
</div>


<script>
  const phrases = [
    "indie hits",
    "tomorrow's headlines",
    "deep cuts",
    "hidden gems",
    "undercover talent"
  ];

  const phraseEl = document.getElementById("welcome-rotating-phrase");
  let index = 0;

  function updatePhrase() {
    index = (index + 1) % phrases.length;
    if (phraseEl) {
      phraseEl.classList.remove("fade-in");
      // force reflow for restart animation
      void phraseEl.offsetWidth;
      phraseEl.textContent = phrases[index];
      phraseEl.classList.add("fade-in");
    }
  }

  setInterval(updatePhrase, 5500);
</script>
  

<style>
.welcomeSubLine {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 600;
  color: white;
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
  line-height: 1.4;
  letter-spacing: -0.01em;
  padding: 0.5rem 1rem;

  /* 💡 Layout stability: reserve space for up to 2 lines */
  min-height: calc(2.5rem * 1.4 * 2.2);

  /* Optional: keep text centered vertically if it doesn't wrap */
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.25rem;
}
  
.welcomePhrase {
  position: relative;
  display: inline-block;
  white-space: nowrap;

  transition: all 0.4s ease;
}

/* Replace border with this */
.welcomePhrase::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0.05em; /* tighter to the text */
  height: 2px;
  width: 100%;
  background-color: rgba(255, 255, 255, 0.6); /* white-ish, tweak as needed */
}

.welcomePlaceholder {
  visibility: hidden;
  position: absolute;
  pointer-events: none;
  height: 0;
  overflow: hidden;
}

/* Keep your existing animation class */
.fade-in {
  animation: fadeSlideUp 0.4s ease forwards;
}

@keyframes fadeSlideUp {
  0% {
    opacity: 0;
    transform: translateY(0.4em);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

</style>